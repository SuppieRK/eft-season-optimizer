{
  "name": "eft-season-optimizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "generate:assets": "node scripts/generate-assets.cjs",
    "build": "tsc --noEmit && npm run generate:assets && vite build",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run && npm run test:catalog",
    "test:catalog": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:build": "npm run build && node scripts/check-build.cjs",
    "audit:lighthouse": "npm run build && node scripts/lighthouse-audit.cjs",
    "validate:release": "node scripts/validate-release.cjs",
    "check": "npm run lint && npm run test:build && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@types/hyphen": "^1.14.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "flag-icons": "^7.6.0",
    "hyphen": "^1.14.1",
    "lucide": "^1.66.0",
    "slim-select": "^4.6.2"
  }
}
